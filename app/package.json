{
  "name": "fabien-poirier-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "embed:search": "tsx scripts/embed-search.ts",
    "knowledge:similarity": "tsx scripts/build-knowledge-similarity.ts",
    "knowledge:graph": "npm run knowledge:similarity && npm run knowledge:taxonomy && npm run knowledge:themes && tsx scripts/export-knowledge-graph.ts",
    "knowledge:viewer": "tsx scripts/export-knowledge-graph.ts",
    "knowledge:viewer:prod": "tsx scripts/export-knowledge-graph.ts --prerender",
    "knowledge:taxonomy": "tsx scripts/check-knowledge-taxonomy.ts",
    "knowledge:themes": "tsx scripts/check-knowledge-themes.ts",
    "knowledge:check": "npm run knowledge:taxonomy && npm run knowledge:themes && tsx scripts/export-knowledge-graph.ts --check",
    "knowledge:refresh": "npm run sync:medium && npm run sync:youtube && npm run knowledge:graph",
    "sync:medium": "node scripts/sync-medium.mjs",
    "sync:youtube": "node scripts/sync-youtube.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/space-grotesk": "^5.2.5",
    "@huggingface/transformers": "^4.3.2",
    "@orama/stemmers": "^3.1.18",
    "minisearch": "^7.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stopword": "^3.1.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/stopword": "^2.0.3",
    "@vitejs/plugin-react": "^4.4.0",
    "fast-xml-parser": "^5.2.0",
    "franc": "^6.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
